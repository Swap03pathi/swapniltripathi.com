{
  // Foursight room server — one Durable Object instance per room code.
  // Deploy: npx wrangler deploy (from game/worker, after one-time `wrangler login`).
  // Local play: npx wrangler dev (no login needed; serves ws on localhost:8787).
  "name": "foursight-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
